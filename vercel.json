{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "",
    "buildCommand": "bash vi/site/vercel-build.sh",
    "outputDirectory": "site",
    "ignoreCommand": "bash vi/site/vercel-ignore.sh",
    "redirects": [
        { "source": "/", "destination": "/vi/", "permanent": false },
        {
            "source": "/:path((?:[^/]+/)*[^/.]+)",
            "destination": "/:path/",
            "permanent": true
        },
        {
            "source": "/vi/lcci/:id(\\d+\\.\\d+)",
            "destination": "/vi/lcci/:id/",
            "permanent": true
        }
    ]
}
